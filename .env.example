# Database
DATABASE_URL=postgresql://user:password@localhost:5432/opentruth

# Web3.Storage - Get token from https://web3.storage
NEXT_PUBLIC_WEB3_STORAGE_TOKEN=your_web3_storage_token_here

# WalletConnect - Get project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Smart Contract Addresses (deploy contracts first, then add addresses)
NEXT_PUBLIC_REPUTATION_TOKEN=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_GOVERNANCE_DAO=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CONTENT_REGISTRY=0x0000000000000000000000000000000000000000

# RPC URLs
NEXT_PUBLIC_POLYGON_RPC=https://polygon-rpc.com

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Node Environment
NODE_ENV=development
